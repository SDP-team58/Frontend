# .env.local.example
# Development environment variables (copy this file to `.env.local` and edit values)
# Do NOT commit `.env.local` — it should contain secrets specific to your environment.

# Secret used to sign JWT auth cookies. Generate a long random value.
# Example generation (macOS / Linux):
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret

# Optional FastAPI backend base URL override.
# If omitted, the frontend will target the current VM host on port 8000.
NEXT_API_BASE_URL=http://your-fastapi-vm:8000
